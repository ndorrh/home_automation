# Smart Home AV Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_CLEAR_MINUTES=30

# PBKDF2-HMAC-SHA256 hashed login password (change via: python scripts/set_password.py)
APP_PASSWORD_HASH=pbkdf2_sha256$600000$b2dc5eaf03247822061705921d742e4a$4c8377b515108237888c5e8b2566be4d439fb5fc326829eea52bea89aa554d4d

# Automatically generated on first run if left empty
SESSION_SECRET=
SESSION_TTL_SECONDS=86400

# X25519 + AES-GCM Recording Encryption (auto-generated on first run; private key wrapped by password)
ENC_PUBLIC_KEY=8-JIFNbNcf1nRjL3pdv52u6PQ8qrKs6N4fy6AKjVPhI=
ENC_PRIVATE_KEY_WRAPPED=v1$600000$fa277a91a37b9ae2596ca982e177a59e$ddc328709d3b3b24edaff3d7$696512e8a24349f514fedf46f42c15badeae00761a7a8fbeed3f317e1aa1359196cce5d9a1a55fab6a639162b68bd556

# Keep PC awake while allowing monitor to turn off (Windows)
PREVENT_SYSTEM_SLEEP=true
AUTO_HOTSPOT_ON_OFFLINE=true

# Free Cloudflare Quick Tunnel (auto-configures on first run)
ENABLE_CLOUDFLARED=true
CLOUDFLARED_BIN=cloudflared

# Windows DPAPI-encrypted Gmail credentials (set via: python scripts/set_gmail.py)
GMAIL_CREDENTIALS_ENC=
EMAIL_RESEND_MINUTES=60

# Media Device Defaults
CAMERA_INDEX=0
AUDIO_SAMPLE_RATE=16000
SCREEN_FPS=6
SCREEN_MONITOR_INDEX=1
